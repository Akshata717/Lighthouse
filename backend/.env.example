# Copy this file to .env and fill in real values. Never commit .env itself.

# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_this_to_a_random_secret

# How long a login lasts, in minutes. 10080 = 7 days.
JWT_EXPIRE_MINUTES=10080

# The origin your frontend runs on (Vite's default dev server).
FRONTEND_ORIGIN=http://localhost:5173
